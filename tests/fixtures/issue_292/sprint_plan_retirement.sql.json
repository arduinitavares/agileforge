"CREATE TABLE sprint_plan_retirements (\n\tretirement_id INTEGER NOT NULL, \n\tproject_id INTEGER NOT NULL, \n\tsprint_plan_artifact_id INTEGER NOT NULL, \n\tsprint_plan_artifact_decision_id INTEGER NOT NULL, \n\tsprint_id INTEGER NOT NULL, \n\tplan_fingerprint VARCHAR NOT NULL, \n\tcandidate_set_fingerprint VARCHAR NOT NULL, \n\trationale TEXT NOT NULL, \n\tretired_by VARCHAR NOT NULL, \n\tretired_at DATETIME NOT NULL, \n\treceipt_id INTEGER NOT NULL, \n\tretirement_fingerprint VARCHAR NOT NULL, \n\tPRIMARY KEY (retirement_id), \n\tCONSTRAINT uq_retired_sprint_plan UNIQUE (sprint_plan_artifact_id), \n\tCONSTRAINT uq_retired_sprint UNIQUE (sprint_id), \n\tCONSTRAINT uq_retirement_receipt UNIQUE (receipt_id), \n\tCONSTRAINT fk_retirement_accepted_plan FOREIGN KEY(project_id, sprint_plan_artifact_id, sprint_plan_artifact_decision_id) REFERENCES sprint_plan_artifact_decisions (project_id, sprint_plan_artifact_id, sprint_plan_artifact_decision_id), \n\tFOREIGN KEY(project_id) REFERENCES projects (project_id), \n\tFOREIGN KEY(sprint_id) REFERENCES sprints (sprint_id), \n\tFOREIGN KEY(receipt_id) REFERENCES workflow_transition_receipts (workflow_transition_receipt_id)\n);"
