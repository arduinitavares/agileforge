"CREATE TABLE workflow_node_attempt_ownership (\n\tworkflow_node_attempt_id INTEGER NOT NULL, \n\tproject_id INTEGER NOT NULL, \n\tattempt_fingerprint VARCHAR NOT NULL, \n\towner_generation VARCHAR NOT NULL, \n\tacquired_at DATETIME NOT NULL, \n\texpires_at DATETIME NOT NULL, \n\trenewal_revision INTEGER NOT NULL, \n\tPRIMARY KEY (workflow_node_attempt_id), \n\tCONSTRAINT fk_workflow_attempt_owner_identity FOREIGN KEY(project_id, workflow_node_attempt_id, attempt_fingerprint) REFERENCES workflow_node_attempts (project_id, workflow_node_attempt_id, attempt_fingerprint), \n\tCONSTRAINT ck_attempt_owner_revision CHECK (renewal_revision >= 0), \n\tCONSTRAINT ck_attempt_owner_expiry CHECK (expires_at > acquired_at), \n\tCONSTRAINT ck_attempt_owner_generation CHECK (length(owner_generation) > 0)\n);\n"
